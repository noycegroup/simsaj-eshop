NEXT_PUBLIC_SITE_URL=https://simsaj.sk
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Verejný kľúč Packeta widgetu vytvorený osobitne pre SIMSAJ.
NEXT_PUBLIC_PACKETA_API_KEY=
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Iba na serveri; nikdy nepoužiť s prefixom NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
# Serverové MyGLS údaje vytvorené osobitne pre SIMSAJ; nikdy nie s NEXT_PUBLIC_ prefixom.
GLS_CLIENT_NUMBER=
GLS_USERNAME=
GLS_PASSWORD=
GLS_API_URL=https://api.mygls.sk/ParcelService.svc/json/PrintLabels
GLS_WEBSHOP_ENGINE=simsaj.sk
DIAWIN_CATALOG_FEED_URL=https://partner.example/catalog.xml
DIAWIN_INVENTORY_FEED_URL=https://partner.example/inventory.xml
# Voliteľná celá hodnota HTTP hlavičky, napríklad: Bearer TOKEN
DIAWIN_FEED_AUTHORIZATION=
SVORTO_FEED_URL=https://partner.example/svorto-feed.xml
